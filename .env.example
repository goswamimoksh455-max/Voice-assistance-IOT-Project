# Server (localhost only by default)
VOICE_ADDR=127.0.0.1:8090
VOICE_MAX_RECORDING_SECONDS=30
VOICE_HISTORY_TURNS=8
VOICE_STT_TIMEOUT=60s
VOICE_LLM_TIMEOUT=30s
VOICE_TTS_TIMEOUT=30s
# Development-only, in-memory audio inspection over the authenticated browser session.
VOICE_AUDIO_DEBUG=false
# Development-only STT evaluation dashboard at /dev/ (localhost clients only).
# Fixtures come from `go run ./cmd/fetch-fixtures`; reports are written to VOICE_REPORT_DIR.
VOICE_DEV_TOOLS=false
VOICE_FIXTURES_DIR=runtime/fixtures
VOICE_REPORT_DIR=runtime/eval

# Local whisper.cpp server (multilingual model; never use *.en models).
# small is the default: base garbles Hindi/Hinglish (often in Urdu script).
WHISPER_URL=http://127.0.0.1:8081
WHISPER_MODEL=models/whisper/ggml-small.bin
# Hindi, Hinglish and Auto are routed to a second, more accurate model (English stays on
# WHISPER_MODEL for speed). Set WHISPER_MULTILINGUAL_URL= (empty) to use one server for all.
WHISPER_MULTILINGUAL_URL=http://127.0.0.1:8082
WHISPER_MULTILINGUAL_MODEL=models/whisper/ggml-large-v3-turbo-q5_0.bin
# Extra whisper-server decoding fields sent with every request, e.g. beam_size=5,temperature_inc=0.
# Leave unset to use the measured default (docs/STT_EVALUATION.md).
# WHISPER_OPTIONS=

# Gemini API (backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_OUTPUT_TOKENS=220

# Two warm Piper services, one voice per process
PIPER_EN_URL=http://127.0.0.1:5000
PIPER_HI_URL=http://127.0.0.1:5001
PIPER_EN_VOICE=en_US-lessac-medium
PIPER_HI_VOICE=hi_IN-priyamvada-medium
